      "position": [0, 300],
      "webhookId": "0d6f2b8e-7a3c-4f61-b5e4-2c9d8a1e6f10"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/extrair/arquivo",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "arquivo",
              "inputDataFieldName": "Nota_fiscal"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "8c2e4a9d-3f71-4b0a-a6c2-5d9e1b7f3a02",
      "name": "API: extrair dados com IA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 300],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "e1a7c3b2-9d4f-4e58-8b16-7f2a0c9d5e03",
              "leftValue": "={{ $json.status }}",
              "rightValue": "OK",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a4d9e2f1-6b3c-4a87-9e05-1c8b7d2f4a04",
      "name": "Passou nas regras?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [520, 200]
    },
    {
      "parameters": {
        "operation": "completion",
        "respondWith": "text",
        "completionTitle": "Nota OK para lançamento",
        "completionMessage": "={{ $json.nota.fornecedor }} · CNPJ {{ $json.nota.cnpj_fornecedor }} · Nota {{ $json.nota.numero_nota }} · Valor R$ {{ Number($json.nota.valor_total).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) }} · Vencimento {{ $json.nota.data_vencimento ? $json.nota.data_vencimento.split('-').reverse().join('/') : 'não informado' }} · Lido por: {{ $json.provedor }}",
        "options": {}
      },
      "id": "c7f1b3e8-2a9d-4c56-8f04-3e1d9b6a7c05",
      "name": "Tela: nota aprovada",
      "type": "n8n-nodes-base.form",
      "typeVersion": 1,
      "position": [780, 100],
      "webhookId": "3a9e7c1d-5b2f-4e80-a6d4-8f1c0b9e2d11"
