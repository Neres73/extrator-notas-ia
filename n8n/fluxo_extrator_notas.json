{
  "name": "Extrator de Notas com IA",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Extrator de Notas com IA",
        "formDescription": "Envie uma nota fiscal (PDF com texto ou TXT). A IA extrai os dados e as regras de negócio dizem se ela pode seguir ou precisa de revisão.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Nota fiscal",
              "fieldType": "file",
              "multipleFiles": false,
              "acceptFileTypes": ".pdf,.txt",
              "requiredField": true
            }
          ]
        },
        "options": {
          "path": "extrator-notas",
          "buttonLabel": "Extrair dados"
        }
      },
