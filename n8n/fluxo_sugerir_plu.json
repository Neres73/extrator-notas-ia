      "position": [520, 460],
      "webhookId": "e1f2a3b4-c5d6-4e7f-9a8b-9c0d1e2f3a11"
    },
    {
      "parameters": {
        "content": "## Assistente de PLU\n1. Suba a API: `uvicorn api:app`\n2. Ative este fluxo e abra a URL do formulário\n3. Envie um PDF de `exemplos/notas` com o fornecedor 1001\n\nA leitura e a regra fiscal ficam na API; o n8n só monta o formulário e mostra a resposta.\n\nn8n em Docker? Troque `localhost` por `host.docker.internal`.",
        "height": 300,
        "width": 380
      },
      "id": "f2a3b4c5-d6e7-4f8a-9b0c-0d1e2f3a4b12",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-60, -40]
    }
  ],
  "connections": {
