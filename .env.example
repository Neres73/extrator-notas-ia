# Copie este arquivo para .env e preencha a chave do provedor que for usar.
# O arquivo .env NÃO vai para o GitHub (está no .gitignore).

# gemini | claude | offline
LLM_PROVEDOR=gemini

# Chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Chave em https://console.anthropic.com (opcional)
ANTHROPIC_API_KEY=

# Opcional: troca o modelo padrão do provedor
# LLM_MODELO=gemini-flash-latest
